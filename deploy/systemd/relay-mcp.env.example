# /etc/default/relay-mcp — environment for relay-mcp.service
#
# Copy this file to /etc/default/relay-mcp and uncomment the settings you
# want to override. All values shown are the defaults.

# URL of the relay daemon the MCP server talks to (relay-mcp never touches
# GPIO directly; GPIO access is handled by the relay daemon).
#RELAY_API_URL=http://localhost:8000

# Optional bearer token sent on every daemon request.
#RELAY_API_TOKEN=

# Seconds enforced between power actions on the same board.
#RELAY_MCP_COOLDOWN=5

# Set to 1 to refuse every tool that changes relay state.
#RELAY_MCP_READ_ONLY=0

# Path of the JSONL audit log.
#RELAY_MCP_AUDIT_LOG=/home/pi/.local/state/relay-mcp/audit.jsonl

# Extra command-line flags appended to ExecStart, e.g. bind host/port,
# board allow-list, or a custom board profile directory.
#RELAY_MCP_OPTS=--host 127.0.0.1 --port 8766 --config-dir /etc/relay/boards.d
