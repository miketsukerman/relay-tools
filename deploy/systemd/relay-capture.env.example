# /etc/default/relay-capture — environment for relay-capture.service
#
# Copy this file to /etc/default/relay-capture and uncomment the settings
# you want to override. All values shown are the defaults.

# Extra command-line flags appended to ExecStart. The device option is a
# glob; the first sorted match is used on every (re)start, so the daemon
# recovers when the dongle is re-plugged.
#RELAY_CAPTURE_OPTS=--device '/dev/v4l/by-id/usb-*-video-index0' --size 1920x1080 --fps 30 --timeout 5 --outdir /var/lib/relay-capture --host 0.0.0.0 --port 8002
