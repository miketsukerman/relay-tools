# 99-relay-console.rules — example udev rules that pin USB-UART adapters to
# stable symlinks, so board profiles can use the same `console.device` path
# no matter which USB port the adapter is plugged into.
#
# Most adapters already get a stable path under /dev/serial/by-id/ derived
# from the USB serial number; prefer that when it is unique. These rules are
# for adapters that need an explicit name, or that share an identical by-id
# path (e.g. clones without a serial number, distinguished by physical port).
#
# Find the attributes of a connected adapter with:
#   udevadm info --attribute-walk --name /dev/ttyUSB0 | less
#
# Install:
#   sudo cp 99-relay-console.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
#
# Then use `device: /dev/relay-console/rom2820` in the board profile.

# Pin by USB serial number (preferred: survives replugging anywhere).
# SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", \
#   ATTRS{serial}=="A10KXXXX", SYMLINK+="relay-console/rom2820", \
#   GROUP="dialout", MODE="0660"

# Pin by physical USB port path (for adapters without a serial number).
# KERNELS is the port chain; find it with udevadm info --attribute-walk.
# SUBSYSTEM=="tty", KERNELS=="1-1.3", SUBSYSTEMS=="usb", \
#   SYMLINK+="relay-console/board-a", GROUP="dialout", MODE="0660"
