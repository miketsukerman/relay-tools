#!/usr/bin/make -f
export DH_VIRTUALENV_INSTALL_ROOT = /opt/venvs

%:
	dh $@ --with python-virtualenv

override_dh_virtualenv:
	# Bundle the full dependency closure (including the MCP SDK via the
	# "mcp" extra) in a self-contained virtualenv. --use-system-packages
	# lets the venv see distro GPIO packages (python3-gpiozero, lgpio,
	# RPi.GPIO) on the target without bundling compiled GPIO bindings.
	# --ignore-installed stops pip from treating packages already present
	# in the *build host's* system site-packages as satisfied; otherwise
	# they are silently left out of the venv (e.g. typing_inspection) and
	# imports fail on targets that lack the same distro packages.
	dh_virtualenv \
		--python /usr/bin/python3 \
		--builtin-venv \
		--upgrade-pip \
		--preinstall "setuptools>=42" \
		--preinstall "wheel" \
		--use-system-packages \
		--extra-pip-arg=--ignore-installed \
		--extras mcp \
		--extras console

override_dh_install:
	dh_install
	install -D -m 0644 deploy/systemd/channels.yaml \
		debian/relay-tools/etc/relay/channels.yaml.example

override_dh_installsystemd:
	dh_installsystemd --name=relay-daemon
	# Ship the root-running unit, but let the admin review
	# /etc/default/relay-mcp before enabling it.
	dh_installsystemd --name=relay-mcp --no-enable --no-start
	# Console capture is opt-in: it needs a console block in a board
	# profile and (usually) a dialout-capable relay user first.
	dh_installsystemd --name=relay-console --no-enable --no-start
	# Screen capture is opt-in: it needs the HDMI-to-USB dongle first.
	dh_installsystemd --name=relay-capture --no-enable --no-start

# The virtualenv ships prebuilt manylinux wheels (e.g. pydantic-core);
# skip Debian stripping and shared-library dependency scanning for them.
override_dh_strip:

override_dh_shlibdeps:
