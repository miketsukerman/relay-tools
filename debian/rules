#!/usr/bin/make -f
export PYBUILD_NAME = relay-tools
export DEB_BUILD_OPTIONS += nocheck

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_install:
	dh_install
	install -D -m 0644 systemd/channels.yaml \
		debian/relay-tools/etc/relay/channels.yaml.example

override_dh_installsystemd:
	dh_installsystemd --name=relay-daemon
	# relay-mcp defaults to User=pi; ship the unit but let the admin
	# review /etc/default/relay-mcp before enabling it.
	dh_installsystemd --name=relay-mcp --no-enable --no-start
